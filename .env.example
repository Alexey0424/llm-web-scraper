# Copy to .env and adjust. No secrets are required for the default run.

# ---- Local LLM (Ollama) -----------------------------------------------------
# Model used by the discovery crawler + extractor. gemma4:e4b is the edge
# variant (effective 4B params, 9.6 GB, 128K context) — fits in VRAM alone.
# gemma4:26b is the higher-quality option on a roomy box.
OLLAMA_MODEL=gemma4:e4b
# Server URL. Inside docker compose this is set for you (http://ollama:11434);
# for host-side runs against the project's container use the published port:
# OLLAMA_HOST=http://localhost:11435

# ---- Fetch engine -----------------------------------------------------------
# Scrapling fetch mode: fast (static HTTP, browser-like headers) | dynamic
# (headless browser, JS rendered) | stealth (headless browser + stealth).
# Default: stealth.
# SCRAPER_MODE=stealth

# Politeness (per-domain delay, retries, UA) lives in config/rate_limits.yaml.
